# Resend API Key - Get one from https://resend.com
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx

# The email address where contact form submissions should be delivered
RECIPIENT_EMAIL=your-email@example.com

# The "From" address shown to recipients. Must be a verified domain in Resend.
# Format: "Display Name <email@your-verified-domain.com>"
CONTACT_FROM_EMAIL="Contact Form <contact@your-verified-domain.com>"